{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 600000" },
        "accent": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "theme": { ".validate": "newData.val() == 'light' || newData.val() == 'dark'" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() == true",
        ".write": "auth != null && ((data.exists() && data.child('members').child(auth.uid).val() == true) || (!data.exists() && newData.child('members').child(auth.uid).val() == true))",
        "type": { ".validate": "newData.val() == 'direct' || newData.val() == 'group' || newData.val() == 'saved'" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 600000" },
        "ownerId": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "members": {
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "last": {
          "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ts": { ".validate": "newData.isNumber()" },
          "senderId": { ".validate": "newData.isString()" },
          "kind": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
        "$mid": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['senderId', 'ts', 'kind'])",
          "senderId": { ".validate": "newData.val() == auth.uid" },
          "kind": { ".validate": "newData.val() == 'text' || newData.val() == 'image' || newData.val() == 'video' || newData.val() == 'file' || newData.val() == 'voice'" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 4096" },
          "ts": { ".validate": "newData.isNumber()" },
          "replyTo": {
            "id": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "author": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other": { ".validate": false }
          },
          "attachment": {
            "path": { ".validate": "newData.isString() && newData.val().length <= 512" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "size": { ".validate": "newData.isNumber()" },
            "mime": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "duration": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "reads": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "unread": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() == true",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "state": { ".validate": "newData.val() == 'online' || newData.val() == 'offline'" },
        "chat": { ".validate": "newData.isString() || newData.val() == null" },
        "typing": { ".validate": "newData.isBoolean()" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
